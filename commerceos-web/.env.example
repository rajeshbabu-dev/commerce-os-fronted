# =============================================================================
# CommerceOS Frontend — Environment Variables Template
# Copy this file to .env or .env.local and set your environment variables.
# =============================================================================

# Backend Protocol, Host, Port and API Prefix
VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PORT=8080
VITE_API_PREFIX=/api/v1

# Backend API Base URL with Variable Injection
VITE_API_BASE_URL=${VITE_API_PROTOCOL}://${VITE_API_HOST}:${VITE_API_PORT}${VITE_API_PREFIX}
