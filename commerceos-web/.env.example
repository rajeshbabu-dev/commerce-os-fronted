# =============================================================================
# CommerceOS Web — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure environment variables as needed:
#   cp .env.example .env
#
# IMPORTANT:
# - ONLY variables prefixed with VITE_ are exposed to the browser.
# - NEVER store backend secrets (JWT secrets, database passwords, API keys) here!
# =============================================================================

# Backend REST API base URL (including /api/v1 prefix)
# Local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Application Environment (development, staging, production)
VITE_APP_ENV=development
